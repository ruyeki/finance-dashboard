# Copy to .env and fill in. Never commit .env.

# --- App ---
# Password to log into the dashboard (single user).
APP_PASSWORD=change-me
# Secret used to sign session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-too
# Fernet key for encrypting Plaid access tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key

# --- Database ---
DATABASE_URL=sqlite:///./data/finance.db

# --- Plaid ---
# Use "sandbox" for development; switch to "production" for the free Trial tier.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Comma-separated Plaid products to request.
PLAID_PRODUCTS=transactions,investments
PLAID_COUNTRY_CODES=US
# Public URL Plaid will POST webhooks to (optional in dev).
PLAID_WEBHOOK_URL=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Uploads ---
UPLOAD_DIR=./data/uploads
